{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "development",
      "env": { "EAS_BUILD_PROFILE": "development" }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "preview",
      "env": { "EAS_BUILD_PROFILE": "preview" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EAS_BUILD_PROFILE": "production" }
    }
  },
  "submit": {
    "production": {}
  }
}